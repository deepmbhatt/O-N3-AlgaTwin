# Local development uses the Vite reverse proxy in vite.config.js.
VITE_ALGATWIN_API_URL=/algatwin

# Optional. This value is visible in browser code; use a server-side proxy for secrets in production.
VITE_ALGATWIN_API_KEY=

# Read-only dashboard refresh interval. Minimum enforced value is 5000 ms.
VITE_ALGATWIN_POLL_MS=15000

# Automatically consume the next 3-row CSV burst and run every pond prediction.
VITE_ALGATWIN_AUTO_PREDICT=true
VITE_ALGATWIN_PREDICT_MS=15000

# Keep the designed demo visible if the API is unavailable. Set false for strict production behavior.
VITE_ALGATWIN_ALLOW_MOCK_FALLBACK=true
